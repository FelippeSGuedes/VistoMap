# Copie para .env neste mesmo diretório e preencha no servidor.
# Nunca commitar o .env real.

DB_HOST=172.31.2.67
DB_USER=glpi_user
DB_PASSWORD=
DB_NAME=glpi
DB_PORT=3306

# Opcionais — só se quiser sobrescrever os defaults de config.py
# (todos derivam de /var/www/html/glpi/plugins/vistomapprojetos por padrão)
# INSTALACAO_TEMPLATES_DIR=/var/www/html/glpi/plugins/vistomapprojetos/templates
# GLPI_UPLOAD_PATH=/var/www/html/glpi/plugins/vistomapprojetos/uploads
# INSTALACAO_FILES_DIR=/var/www/html/glpi/plugins/vistomapprojetos/files_instalacao
# INSTALACAO_APPROVED_DIR=/var/www/html/glpi/plugins/vistomapprojetos/InstalacoesAprovadas
# INSTALACAO_LOGS_DIR=/var/www/html/glpi/plugins/vistomapprojetos/logs
# INSTALACAO_LOG_FILE=/var/www/html/glpi/plugins/vistomapprojetos/logs/worker_instalacao.log
# INSTALACAO_LOCK_FILE=/tmp/vistomap_worker_instalacao.lock
